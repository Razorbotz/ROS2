    <link name='BR_Wheel'>
      <pose>0.183875 -0.538167 0.235883 1.5708 0 -3.14159</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.01</iyy> <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name='BR_Wheel_visual'>
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BR_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='BR_Wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.210439</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <mu2>0.8</mu2> <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>10000000.0</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name='FL_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>FL_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <effort>2000</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>1.0</damping> 
          <friction>1.0</friction>
        </dynamics>
        
      </axis>
    </joint>

    <joint name='FR_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>FR_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <effort>2000</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>1.0</damping> 
          <friction>1.0</friction>
        </dynamics>
        
      </axis>
    </joint>

    <joint name='BL_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>BL_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <effort>2000</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>1.0</damping> 
          <friction>1.0</friction>
        </dynamics>
        
      </axis>
    </joint>

    <joint name='BR_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>BR_Wheel</child>
      <axis>
        <xyz>0 0 1</xyz> 
        <limit>
          <effort>2000</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>1.0</damping> 
          <friction>1.0</friction>
        </dynamics>
        
      </axis>
    </joint>

    <!-- Camera Link -->
    <link name='zed2i_base_link'>
      <pose>0.762639 -0.100614 0.526280 0 0 0</pose>
      <inertial>
        <mass>0.166</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='zed2i_visual'>
        <geometry>
          <box>
            <size>0.03025 0.17525 0.04310</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>

      <sensor name='left_camera_sensor' type='camera'>
        <pose>0 -0.06 0 0 0 0</pose>
        <camera name='left_eye'>
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <plugin name='left_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros_namespace>/my_robot</ros_namespace>
          <camera_name>zed2i/left</camera_name>
          <frame_name>zed2i_left_optical_frame</frame_name>
          <update_rate>30</update_rate>
          <ros_qos>
            <reliability>reliable</reliability>
            <durability>volatile</durability>
          </ros_qos>
        </plugin>
      </sensor>

      <sensor name='right_camera_sensor' type='camera'>
        <pose>0 0.06 0 0 0 0</pose>
        <camera name='right_eye'>
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <plugin name='right_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros_namespace>/my_robot</ros_namespace>
          <camera_name>zed2i/right</camera_name>
          <frame_name>zed2i_right_optical_frame</frame_name>
          <update_rate>30</update_rate>
          <ros_qos>
            <reliability>reliable</reliability>
            <durability>volatile</durability>
          </ros_qos>
        </plugin>
      </sensor>

      <sensor name='imu_sensor' type='imu'>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        
        <visualize>true</visualize>
        <pose>0 0 0 0 0 0</pose>
        
        <plugin name='imu_plugin' filename='libgazebo_ros_imu_sensor.so'>
          <ros>
            <remapping>~/out:=/zed2i/imu/data</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </link>

    <!-- Camera Joints -->
    <joint name='robot_to_zed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>zed2i_base_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <link name='d455i_base_link'>
      <pose>0.85 -0.55 0.5 0 0 0</pose>

      <inertial>
        <mass>0.113</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='d455i_visual'>
        <geometry>
          <box>
            <size>0.026 0.124 0.036</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>

      <sensor name='d455i_color_camera' type='camera'>
        <pose>0 0 0 0 0 0</pose>
        <camera name='d455i_color_cam'>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name='d455i_color_controller' filename='libgazebo_ros_camera.so'>
          <ros_namespace>/my_robot</ros_namespace>
          <camera_name>d455i/color</camera_name>
          <frame_name>d455i_color_optical_frame</frame_name>
          <update_rate>30</update_rate>
          <ros_qos>
            <reliability>reliable</reliability>
            <durability>volatile</durability>
          </ros_qos>
        </plugin>
      </sensor>

      <sensor name="lidar" type="ray">
        <pose>0 0 0.2 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <min_angle>-0.78539816339</min_angle>
              <max_angle>0.78539816339</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <min_angle>-0.348</min_angle>
              <max_angle>0.174</max_angle>
              </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
          <ros_namespace>/my_robot</ros_namespace>
          <remapping>~/out:=/my_robot/d455i/points</remapping>

          <output_type>sensor_msgs/PointCloud2</output_type>
          <ros_qos>
            <reliability>reliable</reliability>
            <durability>volatile</durability>
          </ros_qos>
          <frame_name>lidar_link</frame_name>
          <queue_size>10</queue_size>
        </plugin>
      </sensor>
      </link>

    <joint name='base_to_d455i_joint' type='fixed'>
      <parent>base_link</parent>
      <child>d455i_base_link</child>
      <pose>0 0 0 0 0 -3.14</pose>
    </joint>

    <!-- Arm Joint -->
    <joint name='Arm_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>Arm</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-0.000001</lower>
          <upper>0.0000001</upper>
          <effort>20</effort>
          <velocity>0.00001</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Bucket Joint -->
    <joint name='Bucket_Joint' type='revolute'>
      <parent>Arm</parent>
      <child>Bucket</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>10</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>
    
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/team/SoftwareDevelopment/ROS2/shovel/src/sim/config/controllers.yaml</parameters>
    </plugin>

    <static>0</static>
  </model>
</sdf>