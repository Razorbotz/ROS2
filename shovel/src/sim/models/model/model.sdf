<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='my_robot'>
    <link name='base_link'>
      <inertial>
        <pose>0.501893 -0.254711 0.215763 0 0 0</pose>
        <mass>6.66092</mass>
        <inertia>
          <ixx>0.0559661</ixx>
