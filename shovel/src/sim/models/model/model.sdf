    <!-- Wheel Links -->
    <link name='FL_Wheel'>
      <pose>0.8411 -0.019814 0.235883 1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.01</iyy> <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
