          <ros>
            <namespace>/my_robot</namespace>
            <remapping>~/out:=d455i/imu/data</remapping>
          </ros>
          <frame_name>d455i_imu_link</frame_name>
          <update_rate>100</update_rate>
        </plugin>
      </sensor>
  -->
    </link>

    <joint name='base_to_d455i_joint' type='fixed'>
      <parent>base_link</parent>
      <child>d455i_base_link</child>
      <pose>0 0 0 0 0 -3.14</pose> 
    </joint>

    <!-- Arm Joint -->
    <joint name='Arm_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>Arm</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-0.000001</lower>
          <upper>0.0000001</upper>
          <effort>20</effort>
          <velocity>0.00001</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Bucket Joint -->
    <joint name='Bucket_Joint' type='revolute'>
      <parent>Arm</parent>
      <child>Bucket</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>10</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Wheel Joints -->
    <joint name='FL_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>FL_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>469</effort>
          <velocity>6.68112</velocity>
        </limit>
      </axis>
    </joint>

    <joint name='FR_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>FR_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>469</effort>
          <velocity>6.68112</velocity>
        </limit>
      </axis>
    </joint>

    <joint name='BL_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>BL_Wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>469</effort>
          <velocity>6.68112</velocity>
        </limit>
      </axis>
    </joint>

    <joint name='BR_Wheel_Joint' type='revolute'>
      <parent>base_link</parent>
      <child>BR_Wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>469</effort>
          <velocity>6.68112</velocity>
        </limit>
      </axis>
    </joint>

  <plugin name="my_robot_drive_front" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/my_robot</namespace>
    </ros>
    <wheel_separation>0.657352</wheel_separation>
    <wheel_diameter>0.420878</wheel_diameter>

    <left_joint>FL_Wheel_Joint</left_joint>
    <right_joint>FR_Wheel_Joint</right_joint>

    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <update_rate>100.0</update_rate>
  </plugin>

  <plugin name="my_robot_drive_back" filename="libgazebo_ros_diff_drive.so">
    <ros>
      <namespace>/my_robot</namespace>
    </ros>
    <wheel_separation>0.657352</wheel_separation>
    <wheel_diameter>0.420878</wheel_diameter>

    <left_joint>BL_Wheel_Joint</left_joint>
    <right_joint>BR_Wheel_Joint</right_joint>

    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <update_rate>100.0</update_rate>
  </plugin>


    <static>0</static>
  </model>
</sdf>
