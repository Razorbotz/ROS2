        </geometry>
      </visual>
      <collision name='FL_Wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.210439</radius> <length>0.1</length>      </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu> <mu2>0.8</mu2> <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode><kp>10000000.0</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
    </link>

    <link name='FR_Wheel'>
      <pose>0.8411 -0.538167 0.235883 1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.01</iyy> <iyz>0</iyz>
