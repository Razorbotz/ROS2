<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='my_robot'>
    <!-- Base Link -->
    <link name='base_link'>
      <inertial>
        <pose>0.501893 -0.254711 0.215763 0 0 0</pose>
        <mass>6.66092</mass>
        <inertia>
          <ixx>0.0559661</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0621717</iyy>
          <iyz>0</iyz>
          <izz>0.104809</izz>
        </inertia>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <visual name='base_link_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/base_link.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='base_link_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/base_link.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Arm Link -->
    <link name='Arm'>
      <pose>0.28468 -0.22263 0.30621 1.5708 0 0</pose>
      <inertial>
        <pose>0.385119 0.125927 0.125764 0 0 0</pose>
        <mass>0.949651</mass>
        <inertia>
          <ixx>0.00497965</ixx>
          <iyy>0.0120414</iyy>
          <izz>0.0123301</izz>
        </inertia>
      </inertial>
      <visual name='Arm_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/Arm.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='Arm_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/Arm.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Bucket Link -->
    <link name='Bucket'>
      <pose>1.09119 -0.14052 0.236472 1.5708 -0 0</pose>
      <inertial>
        <pose>0.087897 0.011351 0.127 0 0 0</pose>
        <mass>1.36392</mass>
        <inertia>
          <ixx>0.0214664</ixx>
          <iyy>0.0251992</iyy>
          <izz>0.00731207</izz>
        </inertia>
      </inertial>
      <visual name='Bucket_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/Bucket.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='Bucket_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/Bucket.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Wheel Links -->
    <link name='FL_Wheel'>
      <pose>0.8411 -0.019814 0.235883 1.5708 0 0</pose>
      <inertial>
        <mass>1.49574</mass>
        <inertia>
          <ixx>0.0112647</ixx>
          <iyy>0.0112647</iyy>
          <izz>0.0195379</izz>
        </inertia>
      </inertial>
      <visual name='FL_Wheel_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/FL_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='FL_Wheel_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/FL_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>    <mu2>0.1</mu2>   </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='FR_Wheel'>
      <pose>0.8411 -0.538167 0.235883 1.5708 0 0</pose>
      <inertial>
        <mass>1.49574</mass>
        <inertia>
          <ixx>0.0112647</ixx>
          <iyy>0.0112647</iyy>
          <izz>0.0195379</izz>
        </inertia>
      </inertial>
      <visual name='FR_Wheel_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/FR_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='FR_Wheel_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/FR_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>    <mu2>0.1</mu2>   </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='BL_Wheel'>
      <pose>0.18387 0 0.23588 1.5708 0 0</pose>
      <inertial>
        <mass>1.49574</mass>
        <inertia>
          <ixx>0.0112647</ixx>
          <iyy>0.0112647</iyy>
          <izz>0.0195379</izz>
        </inertia>
      </inertial>
      <visual name='BL_Wheel_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BL_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='BL_Wheel_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BL_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>    <mu2>0.1</mu2>   </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='BR_Wheel'>
      <pose>0.183875 -0.475714 0.235883 1.5708 0.20707 -3.14159</pose>
      <inertial>
        <mass>1.49574</mass>
        <inertia>
          <ixx>0.0112647</ixx>
          <iyy>0.0112647</iyy>
          <izz>0.0195379</izz>
        </inertia>
      </inertial>
      <visual name='BR_Wheel_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BR_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='BR_Wheel_collision'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BR_Wheel.STL</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>    <mu2>0.1</mu2>   </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Camera Link -->
    <link name='zed2i_base_link'>
      <pose>0.762639 -0.100614 0.526280 0 0 0</pose> 
      <inertial>
        <mass>0.166</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name='zed2i_visual'>
        <geometry>
          <box>
            <size>0.03025 0.17525 0.04310</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      
      <sensor name='left_camera_sensor' type='camera'>
        <pose>0 -0.06 0 0 0 0</pose>
        <camera name='left_eye'>
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <plugin name='left_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/my_robot</namespace>
          </ros>
          <camera_name>zed2i/left</camera_name>
          <frame_name>zed2i_left_optical_frame</frame_name>
          <update_rate>30</update_rate>
          <qos>reliable</qos>
        </plugin>
      </sensor>
      
      <sensor name='right_camera_sensor' type='camera'>
        <pose>0 0.06 0 0 0 0</pose>
        <camera name='right_eye'>
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <plugin name='right_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/my_robot</namespace>
          </ros>
          <camera_name>zed2i/right</camera_name>
          <frame_name>zed2i_right_optical_frame</frame_name>
          <update_rate>30</update_rate>
          <qos>reliable</qos>
        </plugin>
      </sensor>

      <sensor name='imu_sensor' type='imu'>
        <pose>0 0 0 0 0 0</pose>
        <plugin name='imu_plugin' filename='libgazebo_ros_imu_sensor.so'>
          <ros>
            <namespace>/my_robot</namespace>
            <remapping>~/out:=zed2i/imu/data</remapping>
          </ros>
          <frame_name>zed2i_imu_link</frame_name>
          <update_rate>100</update_rate>
        </plugin>
      </sensor>
    </link>

    <!-- Camera Joints -->
    <joint name='robot_to_zed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>zed2i_base_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <link name='d455i_base_link'>
      <pose>0.85 -0.55 0.5 0 0 0</pose> 

      <inertial>
        <mass>0.113</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name='d455i_visual'>
        <geometry>
          <box>
            <size>0.026 0.124 0.036</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
      
      <sensor name='d455i_color_camera' type='camera'>
        <pose>0 0 0 0 0 0</pose>
        <camera name='d455i_color_cam'>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name='d455i_color_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/my_robot</namespace>
          </ros>
          <camera_name>d455i/color</camera_name>
          <frame_name>d455i_color_optical_frame</frame_name>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>

      <sensor name="lidar" type="ray">
        <pose>0 0 0.2 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <min_angle>-0.78539816339</min_angle>
              <max_angle>0.78539816339</max_angle>
            </horizontal>
            <vertical>
              <samples>40</samples>
              <min_angle>-0.348</min_angle>  <!-- -10 deg -->
              <max_angle>0.174</max_angle>   <!-- 10 deg -->
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/my_robot</namespace>
            <remapping>~/out:=/my_robot/d455i/points</remapping>
          </ros>
          <ros_qos>
            <reliability>reliable</reliability>
            <durability>volatile</durability>
          </ros_qos>
          <frame_name>lidar_link</frame_name>
          <queue_size>10</queue_size>
        </plugin>
      </sensor>
<!--
      <sensor name='d455i_depth_sensor' type='ray'>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>1280</samples>
              <resolution>1</resolution>
              <min_angle>-0.759</min_angle> <max_angle>0.759</max_angle>  </horizontal>
            <vertical>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-0.506</min_angle> <max_angle>0.506</max_angle>  </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
