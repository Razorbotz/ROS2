    <link name='BL_Wheel'>
      <pose>0.18387 0 0.23588 1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.01</iyy> <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name='BL_Wheel_visual'>
        <geometry>
          <mesh>
            <uri>model://model/meshes/BL_Wheel.STL</uri>
