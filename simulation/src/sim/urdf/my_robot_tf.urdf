<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <inertial>
      <origin xyz="0.501893 -0.254711 0.215763" rpy="0 0 0"/>
      <mass value="6.66092"/>
      <inertia ixx="0.0559661" ixy="0" ixz="0" iyy="0.0621717" iyz="0" izz="0.104809"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/base_link.STL" scale="1 1 1"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/base_link.STL" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <link name="Arm">
    <inertial>
      <origin xyz="0.385119 0.125927 0.125764" rpy="0 0 0"/>
      <mass value="0.949651"/>
      <inertia ixx="0.00497965" ixy="0" ixz="0" iyy="0.0120414" iyz="0" izz="0.0123301"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/Arm.STL" scale="1 1 1"/>
      </geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/Arm.STL" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="Arm_Joint" type="revolute">
    <parent link="base_link"/>
    <child link="Arm"/>
    <!-- SDF Arm link pose -->
    <origin xyz="0.28468 -0.22263 0.30621" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.7" upper="0.3" effort="120" velocity="1.5"/>
    <dynamics damping="2.0" friction="0.2"/>
  </joint>

  <link name="Bucket">
    <inertial>
      <origin xyz="0.087897 0.011351 0.127" rpy="0 0 0"/>
      <mass value="1.36392"/>
      <inertia ixx="0.0214664" ixy="0" ixz="0" iyy="0.0251992" iyz="0" izz="0.00731207"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/Bucket.STL" scale="1 1 1"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.18"/>
      </geometry>
    </collision>
  </link>

  <joint name="Bucket_Joint" type="revolute">
    <parent link="Arm"/>
    <child link="Bucket"/>
    <!-- FIXED: Bucket pose relative to Arm pose -->
    <origin xyz="0.80651 0.07211 -0.069738" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.25" upper="0.45" effort="80" velocity="2.0"/>
    <dynamics damping="1.5" friction="0.15"/>
  </joint>

<link name="FL_Wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/FL_Wheel.STL" scale="1 1 1"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.210439" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_Wheel_Joint" type="continuous">
    <parent link="base_link"/>
    <child link="FL_Wheel"/>
    <origin xyz="0.8411 -0.019814 0.235883" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="2000" velocity="20"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="FR_Wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/FR_Wheel.STL" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.210439" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="FR_Wheel_Joint" type="continuous">
    <parent link="base_link"/>
    <child link="FR_Wheel"/>
    <origin xyz="0.8411 -0.538167 0.235883" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="2000" velocity="20"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="BL_Wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://sim/models/model/meshes/BL_Wheel.STL" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.210439" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="BL_Wheel_Joint" type="continuous">
    <parent link="base_link"/>
    <child link="BL_Wheel"/>
    <origin xyz="0.18387 0 0.23588" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="2000" velocity="20"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="BR_Wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="package://sim/models/model/meshes/BR_Wheel.STL" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.210439" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="BR_Wheel_Joint" type="continuous">
    <parent link="base_link"/>
    <child link="BR_Wheel"/>
    <origin xyz="0.183875 -0.538167 0.235883" rpy="1.5708 0 -3.14159"/>
    <axis xyz="0 0 1"/>
    <limit effort="2000" velocity="20"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>

  <link name="zed2i_base_link"/>
  <joint name="base_to_zed2i" type="fixed">
    <parent link="base_link"/>
    <child link="zed2i_base_link"/>
    <!-- match SDF: 0.762639 -0.100614 0.526280 -->
    <origin xyz="0.762639 -0.100614 0.526280" rpy="0 0 0"/>
  </joint>

  <link name="d455i_base_link"/>
  <joint name="base_to_d455i" type="fixed">
    <parent link="base_link"/>
    <child link="d455i_base_link"/>
    <!-- match SDF link pose AND joint yaw (SDF joint pose yaw = -3.14) -->
    <origin xyz="0.85 -0.55 0.5" rpy="0 0 -3.14"/>
  </joint>

  <!-- Lidar frame (matches SDF sensor frame_name="lidar_link" and pose z=0.2 inside d455i link) -->
  <link name="lidar_link"/>
  <joint name="d455i_to_lidar" type="fixed">
    <parent link="d455i_base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (keep if you want Foxglove camera frames) -->
  <link name="zed2i_left_optical_frame"/>
  <joint name="zed2i_optical_joint" type="fixed">
    <parent link="zed2i_base_link"/>
    <child link="zed2i_left_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>


  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plu
      gin>
    </hardware>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>REPLACE_WITH_CONTROLLER_YAML</parameters>
    </plugin>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
    </plugin>
  </gazebo>

</robot>